# =============================================================
# DATABASE_URL — escolha um dos exemplos abaixo e remova o "#"
# =============================================================

# --- SQLite (local, sem servidor) ---
# DATABASE_URL=sqlite:///./todo.db

# --- PostgreSQL (local) ---
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/nome_do_banco

# --- PostgreSQL (remoto — RDS AWS) ---
# DATABASE_URL=postgresql+psycopg2://<usuario>:<senha>@lab-database.cjxr6a3xdifa.us-east-1.rds.amazonaws.com:5432/<nome_do_banco>

# --- MySQL (local) ---
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/nome_do_banco

# --- MySQL (remoto — EC2 / RDS / outro servidor) ---
# DATABASE_URL=mysql+pymysql://usuario:senha@<IP_OU_HOST>:3306/nome_do_banco

